{
    "luci-app-smartdns": {
        "description": "Grant access to LuCI app smartdns",
        "read": {
            "cgi-io": [ "exec", "upload" ],
            "file": {
                "/etc/smartdns/**": [ "read" ],
                "/usr/libexec/smartdns-call": [ "exec" ],
                "/etc/init.d/smartdns": [ "exec" ]
            },
            "ubus": {
                "service": [ "list" ]
            },
            "uci": [ "smartdns" ]
        },
        "write": {
            "file": {
                "/etc/smartdns/**": [ "write" ]
            },
            "uci": [ "smartdns" ]
        }
    }
}