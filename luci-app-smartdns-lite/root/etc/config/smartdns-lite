config smartdns-lite
	option enabled '0'
	option ui '0'
	option cache_size '8000'
	option speed_check_mode 'tcp-syn:443,tcp-syn:80,ping'
	option response_mode 'first-ping'
	option prefetch_domain '1'
	option mdns_lookup '1'
	list servers 'h3://dns.alidns.com/dns-query'
	list servers 'https://doh.pub/dns-query'
	list servers 'udp://223.5.5.5 -bootstrap-dns'
	list servers 'udp://119.29.29.29 -bootstrap-dns'
