
config smartdns
	option enabled '0'
	option ui '0'
	option cache_size '8000'
	option speed_check_mode 'tcp-syn:443,tcp-syn:80,ping'
	option tcp_server '0'
	option prefetch_domain '1'
	option mdns_lookup '1'

config domain-rule

config server
	option enabled '0'
	option name 'Alidns'
	option ip 'quic://dns.alidns.com'
	option type 'quic'

config server
	option enabled '1'
	option name 'Alidns'
	option ip 'h3://dns.alidns.com/dns-query'
	option type 'h3'

config server
	option enabled '1'
	option name 'DNSPod'
	option ip 'https://doh.pub/dns-query'
	option type 'https'

config server
	option enabled '1'
	option name 'Bootstrap DNS'
	option ip '223.5.5.5'
	option type 'udp'
	option addition_arg '-bootstrap-dns'

config server
	option enabled '1'
	option name 'Bootstrap DNS'
	option ip '119.29.29.29'
	option type 'udp'
	option addition_arg '-bootstrap-dns'